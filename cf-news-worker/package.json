{
  "name": "cf-news-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker for daily news aggregation",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute news-db --local --file=./src/db/schema.sql",
    "db:init:remote": "wrangler d1 execute news-db --remote --file=./src/db/schema.sql",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "cloudflare",
    "worker",
    "news",
    "rss"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.10.0",
    "sql.js": "^1.11.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.119.0"
  }
}

# Cloudflare API Token (需要 D1、Workers、R2、Analytics、Email Routing、Radar 权限)
CLOUDFLARE_API_TOKEN=your-api-token-here

# Radar API Token（同 CLOUDFLARE_API_TOKEN，需含 Account:Radar 权限；作为 worker secret）
RADAR_API_TOKEN=your-radar-api-token

# Cloudflare 资源 ID（在 Cloudflare Dashboard 或通过 wrangler 创建后获取）
D1_DATABASE_ID=your-d1-database-id
KV_NAMESPACE_ID=your-kv-namespace-id
ZONE_ID=your-zone-id
ROUTE_PATTERN=your-domain.com/*

# JWT 密钥（用于用户认证 token 签发）
JWT_SECRET=your-jwt-secret

# AI 服务 API Keys
OPENROUTER_API_KEY=your-openrouter-key
NVIDIA_API_KEY=your-nvidia-key
MANGO_API_KEY=your-mango-key
GROQ_API_KEY=your-groq-key
FREEMODEL_API_KEY=your-freemodel-key
AGNES_API_KEY=your-agnes-key
ZEN_API_KEY=your-zen-api-key
ORCAROUTER_API_KEY=your-orcarouter-api-key
ZHIPU_API_KEY=your-zhipu-api-key
SENSENOVA_API_KEY=your-sensenova-api-key

# Turnstile
TURNSTILE_SECRET=your-turnstile-secret
TURNSTILE_SITE_KEY=your-turnstile-site-key

# GitHub（用于 CI 推送 secrets）
GITHUB_PAT=your-github-token
GITHUB_REPO=your-username/your-repo

# AI Search API Token（用于 wrangler ai-search 命令）
AI_SEARCH_TOKEN=your-ai-search-token

# Web Push VAPID 密钥（雷达命中推送，用 openssl 生成 P-256 密钥对）
VAPID_PRIVATE_KEY=your-vapid-private-hex
VAPID_PUBLIC_KEY=your-vapid-public-hex

# Pixabay 免费图库 key（无图新闻自动配图；https://pixabay.com/api/docs/ 注册获取）
PIXABAY_API_KEY=your-pixabay-api-key

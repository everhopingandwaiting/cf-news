name = "cf-news-worker"
main = "src/index.ts"
compatibility_date = "2026-05-28"

# Smart Placement — 自动将 Worker 移到靠近上游 API（AI 提供商/RSS 源）的位置
[placement]
mode = "smart"

# Static assets (React frontend)
[assets]
directory = "./public"
not_found_handling = "single-page-application"

# D1 Database（database_id 从 .env 的 D1_DATABASE_ID 注入）
[[d1_databases]]
binding = "DB"
database_name = "news-db"
database_id = "${D1_DATABASE_ID}"

# Workers AI
[ai]
binding = "AI"

# KV Namespace
[[kv_namespaces]]
binding = "KV"
id = "${KV_NAMESPACE_ID}"

# Durable Object - 共享粘贴板
[[durable_objects.bindings]]
name = "CLIPBOARD"
class_name = "ClipboardRoom"

# Vectorize - 语义去重
[[vectorize]]
binding = "VECTORIZE"
index_name = "news-dedup"

# Durable Object - 实时评论
[[durable_objects.bindings]]
name = "COMMENTS"
class_name = "CommentsRoom"

# Durable Object - 文件传输 HTTP Piping
[[durable_objects.bindings]]
name = "PIPING"
class_name = "PipingRoom"

# Email Sending
[[send_email]]
name = "EMAIL"

# R2 — 图片代理缓存 + AI 插画持久化
[[r2_buckets]]
binding = "R2_IMAGES"
bucket_name = "cf-news-images"

# Workflows — 后台长任务（backfill 等）
[[workflows]]
name = "backfill-workflow"
binding = "BACKFILL_WORKFLOW"
class_name = "BackfillWorkflow"

# Analytics Engine — 自定义埋点（搜索热词、AI 调用统计）
[[analytics_engine_datasets]]
binding = "ANALYTICS"
dataset = "cf_news_events"

# Browser Rendering（JS 渲染抓取）
[browser]
binding = "BROWSER"

# Queues（异步新闻处理队列）
[[queues.producers]]
queue = "news-processing-queue"
binding = "NEWS_QUEUE"

[[queues.consumers]]
queue = "news-processing-queue"
max_batch_size = 5
max_batch_timeout = 30
# 毒消息（重试 3 次仍失败）投递到 DLQ，防止卡住队列头部饿死其他消息
# （2026-08-11 事故：generate_summary 爆 subrequest 导致 fetch_source 被饿死 8 小时）
dead_letter_queue = "news-processing-dlq"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["ClipboardRoom"]

[[migrations]]
tag = "v2"
new_sqlite_classes = ["CommentsRoom"]

[[migrations]]
tag = "v3"
new_sqlite_classes = ["PipingRoom"]

# 环境变量（用 wrangler secret 设置的密钥不在此显示）
[vars]
NEWS_FETCH_INTERVAL = "3600"           # 新闻抓取间隔（秒）
TURNSTILE_SITE_KEY = "${TURNSTILE_SITE_KEY}"    # Turnstile 站点公钥

# 全局限流（每个 IP 100次/分钟）
[[ratelimits]]
name = "GLOBAL_RATE_LIMITER"
namespace_id = "1001"

  [ratelimits.simple]
  limit = 100
  period = 60

# AI Search 绑定
[[ai_search]]
binding = "AI_SEARCH"
instance_name = "news-search"

# 以下密钥需通过 `wrangler secret put` 设置：
#   JWT_SECRET — 用户认证 token 签发密钥
#   OPENROUTER_API_KEY — AI 摘要服务（主）
#   NVIDIA_API_KEY — AI 摘要服务（备）
#   MANGO_API_KEY — AI 摘要服务（备）

[[routes]]
pattern = "${ROUTE_PATTERN}"
zone_id = "${ZONE_ID}"

# Cron Triggers
[triggers]
crons = ["0 * * * *", "*/5 * * * *", "*/15 * * * *", "0 8 * * *"]

[observability]
enabled = true

# 开发环境配置
[env.dev]
name = "cf-news-worker-dev"

[[env.dev.d1_databases]]
binding = "DB"
database_name = "news-db-dev"
database_id = "YOUR_DEV_D1_DATABASE_ID"

[[env.dev.kv_namespaces]]
binding = "KV"
id = "YOUR_DEV_KV_NAMESPACE_ID"
